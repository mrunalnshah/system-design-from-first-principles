---
/**
 * The all-articles archive at `articles/` (REQ-ART-002, routes.md): every published article, by year. The empty
 * state's "Start with the book" goes to Chapter 1, or to the contents page while no chapter is published.
 */
import { ArticlesArchive } from "../../features/articles/index.ts";
import { startAddress } from "../../features/book/index.ts";
import { getArticles, getBook } from "../../features/content/index.ts";
import { BaseLayout } from "../../features/site/index.ts";

const [articles, book] = await Promise.all([getArticles(), getBook()]);
---

<BaseLayout
  title="Articles"
  description={`Standalone essays by ${book.settings.author}, outside the book ${book.settings.title}.`}
  route={{ kind: "articles" }}
  book={book.settings}
  current="articles"
>
  <ArticlesArchive articles={articles} start={startAddress(book)} />
</BaseLayout>
