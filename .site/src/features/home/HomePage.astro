---
/**
 * The homepage (MOD-home, REQ-HOME-001…004, design/screens/home.md): the book hero now; featured chapters and the
 * latest articles join it in T-02.06. No JavaScript of its own, by construction: nothing here has a script, and
 * the hero's figure is a plain link (REQ-HOME-004).
 * Props: `book` (the published book), `articles` (published articles, for the latest-articles section, T-02.06).
 */
import type { ArticleData, Book } from "../content/index.ts";
import BookHero from "./BookHero.astro";

interface Props {
  book: Book;
  articles: ArticleData[];
}
const { book } = Astro.props;
---

<div class="home site-wrap">
  <BookHero book={book} />
</div>
