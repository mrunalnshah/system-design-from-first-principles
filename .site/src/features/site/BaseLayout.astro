---
/**
 * The page every page uses (MOD-site, REQ-SITE-001/002/005/008): language, the head tags (title, description,
 * canonical address, Open Graph, CSP; head.ts), the self-hosted fonts and tokens, a skip link, the header, one
 * <main>, and the footer.
 *
 * Props: `title` (the page's own title; the book's is added), `description` (one sentence for search results and link
 * previews), `route` (this page's address, for the canonical link; leave it out for the 404 and redirect pages, which
 * get `noindex`), `ogImage` (an asset path for link previews), `book` (title, author and portfolio from book.md:
 * this module can't read the vault, so pages hand it over), `current` / `section` (the header link that is this page,
 * or whose section it's in), and `type`.
 */
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/jetbrains-mono";
import "./tokens.css";
import "./site.css";
import { headTags, type PageHead } from "./head.ts";
import type { Route } from "./url.ts";
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  route?: Route;
  ogImage?: string;
  book: { title: string; author: string; authorUrl: string };
  current?: "contents" | "articles" | "about";
  section?: "contents" | "articles" | "about";
  type?: PageHead["type"];
}

const { title, description, route, ogImage, book, current, section, type } = Astro.props;
const tags = headTags({ title, description, book: book.title, ...(route ? { route } : {}), ...(ogImage ? { ogImage } : {}), ...(type ? { type } : {}) });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {
      tags.map((t) =>
        t.tag === "title" ? <title>{t.text}</title> : t.tag === "link" ? <link {...t.attrs} /> : <meta {...t.attrs} />,
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader book={book} current={current} section={section} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter book={book} />
  </body>
</html>
