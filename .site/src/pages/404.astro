---
// Not-found page (thin slice, T-00.08): GitHub Pages serves it for unknown addresses under the base path (CNF-005).
// The designed version arrives in T-03.04.
import { getBook } from "../features/content/index.ts";
import { BaseLayout, url } from "../features/site/index.ts";

const book = await getBook();
---

<BaseLayout title="Page not found" description="This page doesn't exist." book={book.settings}>
  <div class="site-wrap">
    <h1>Page not found</h1>
    <p>This page may have moved. <a href={url({ kind: "home" })}>Go to the homepage</a>.</p>
  </div>
</BaseLayout>
