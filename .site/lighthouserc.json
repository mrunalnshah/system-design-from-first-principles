{
  "ci": {
    "collect": {
      "startServerCommand": "node node_modules/astro/bin/astro.mjs preview --port 4335 --host localhost",
      "startServerReadyPattern": "localhost:4335",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4335/system-design-from-first-principles/",
        "http://localhost:4335/system-design-from-first-principles/book/",
        "http://localhost:4335/system-design-from-first-principles/book/computer-architecture/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
