---
/**
 * One chapter on the homepage (design/components.md ChapterCard, REQ-HOME-002): the chapter's number, large and
 * faint, "Part I · Foundations", the title, the summary (3 lines at most) and the reading time. The title is the
 * link ("Chapter 1: Computer Architecture", the number said in words since the big one is hidden from screen
 * readers), stretched over the whole card so the card is one link to click; the part, summary and time describe
 * it. Only the title is the link's name, so its name holds all its visible text (WCAG 2.5.3, axe
 * label-content-name-mismatch). Hover underlines the title; focus rings the whole card.
 * Props: `chapter` (a published chapter). The parent puts each card in a list item.
 */
import type { ChapterData } from "../content/index.ts";
import { url } from "../site/index.ts";

interface Props {
  chapter: ChapterData;
}
const { chapter } = Astro.props;
const id = `card-${chapter.slug}`;
---

<div class="card">
  <span class="card-number" aria-hidden="true">{chapter.number}</span>
  <span class="card-part" id={`${id}-part`}>Part {chapter.part.romanNumeral} · {chapter.part.title}</span>
  <h3 class="card-title">
    <a href={url({ kind: "chapter", slug: chapter.slug })} aria-describedby={`${id}-part ${id}-summary ${id}-time`}
      ><span class="visually-hidden">Chapter {chapter.number}: </span>{chapter.title}</a
    >
  </h3>
  <p class="card-summary" id={`${id}-summary`}>{chapter.summary}</p>
  <span class="card-time" id={`${id}-time`}>{chapter.readingMinutes} min read</span>
</div>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    block-size: 100%;
    padding: var(--space-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .card:hover {
    border-color: var(--color-accent);
  }

  /* The whole card is the link's target; the ring goes round the card, not the title. */
  .card a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }

  .card a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .card-number {
    font-size: 2.25rem;
    font-weight: var(--font-weight-bold);
    line-height: 1;
    color: var(--color-chapter-number);
  }

  .card-part {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .card-title {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .card-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .card:hover .card-title a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Long summaries stop at 3 lines (design/screens/home.md, "Long text"). */
  .card-summary {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .card-time {
    margin-block-start: auto;
    padding-block-start: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
