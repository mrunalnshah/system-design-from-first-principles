---
/**
 * The homepage at the site's root (REQ-HOME-001, routes.md): the book hero (T-02.05); featured chapters and the
 * latest articles arrive in T-02.06.
 */
import { getArticles, getBook } from "../features/content/index.ts";
import { HomePage } from "../features/home/index.ts";
import { BaseLayout } from "../features/site/index.ts";

const [book, articles] = await Promise.all([getBook(), getArticles()]);
---

<BaseLayout
  title={book.settings.title}
  description={book.settings.subtitle ?? book.settings.title}
  route={{ kind: "home" }}
  book={book.settings}
>
  <HomePage book={book} articles={articles} />
</BaseLayout>
