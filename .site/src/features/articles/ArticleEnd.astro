---
/**
 * The end of an article (REQ-READ-009, design/screens/article.md): "All articles →" to the archive and
 * "Read the book →" to the contents page, so a reader who came for one essay finds the rest. Styled by the
 * reader (`.reader-end`), like the About page's end. No props.
 */
import { url } from "../site/index.ts";
---

<nav class="reader-end" aria-label="After the article">
  <a href={url({ kind: "articles" })}>All articles →</a>
  <a href={url({ kind: "contents" })}>Read the book →</a>
</nav>
