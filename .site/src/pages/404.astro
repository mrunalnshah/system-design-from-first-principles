---
/**
 * The not-found page (REQ-SITE-004, design/screens/not-found.md): GitHub Pages serves `404.html` for every unknown
 * address under the base path, with status 404 (CNF-005, checked live). No `route`, so it gets `noindex` and no
 * canonical address. "Read from the start" goes to Chapter 1, or to the contents page while none is published.
 */
import { startAddress } from "../features/book/index.ts";
import { getBook } from "../features/content/index.ts";
import { BaseLayout, NotFound } from "../features/site/index.ts";

const book = await getBook();
---

<BaseLayout title="Page not found" description="This page doesn't exist. It may have moved when a chapter was renamed." book={book.settings}>
  <NotFound start={startAddress(book)} />
</BaseLayout>
