---
/**
 * The calm reading page (REQ-READ-001, REQ-READ-002, ADR-0006): at 1100 px and wider, three zones (the chapter menu,
 * the reading column of about 70 characters, and the margin for notes); narrower, one column. It brings in the styles
 * for what the Markdown renderer writes (content.css: math and code), the figures' styles (MOD-diagrams) and its own.
 * Nothing overlays the text unless the reader asks, and nothing animates for readers who ask for less motion.
 * Props: `kind`, "chapter", "article" or "page"; `diagrams`, whether the page gets the full-screen diagram viewer.
 * Slots: `menu` (chapter menu, T-01.17), the default slot (title and text), and `end` (previous/next, links).
 * Its script turns margin-note markers into toggles on narrow screens (client/margin-notes.ts, T-01.18) and binds
 * the arrow keys to a chapter's rel=prev/next (client/keyboard-nav.ts, T-02.04).
 */
import { DiagramViewer } from "../diagrams/index.ts";
import "./content.css";
import "./reader.css";

interface Props {
  kind: "chapter" | "article" | "page";
  /** The entry shows diagrams: the page gets the full-screen viewer (MOD-diagrams), and only then. */
  diagrams?: boolean;
}
const { kind, diagrams = false } = Astro.props;
---

<div class:list={["reader", `reader--${kind}`]}>
  {kind === "chapter" && <div class="reader-menu"><slot name="menu" /></div>}
  <article class="reader-column">
    <slot />
    <slot name="end" />
  </article>
</div>
{diagrams && <DiagramViewer />}

<script>
  import { bindKeyboardNav } from "./client/keyboard-nav.ts";
  import { bindMarginNotes } from "./client/margin-notes.ts";
  bindMarginNotes();
  bindKeyboardNav();
</script>
