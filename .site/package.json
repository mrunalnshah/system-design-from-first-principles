{
  "name": "sdfp-website",
  "version": "0.1.0",
  "description": "Website for the book System Design from First Principles, built from the Obsidian vault one folder up.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node tools/cli.ts tokens",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:boundaries": "depcruise src tools --config .dependency-cruiser.cjs --ts-config tsconfig.json",
    "format": "prettier --write .",
    "tools": "node tools/cli.ts",
    "sync": "node tools/cli.ts sync",
    "setup-hooks": "git config core.hooksPath .site/tools/hooks"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@panzoom/panzoom": "4.6.2",
    "astro": "7.4.13",
    "katex": "0.19.1",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "linkinator": "8.1.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
